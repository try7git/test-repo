<Window x:Class="GymManagementSystem.Views.SubscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Abonelik Yonetimi" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F0F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <TextBlock Text="🎫  Abonelik Yonetimi" FontSize="18" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center" Margin="25,0"/>
        </Border>

        <!-- İçerik -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: Mevcut Abonelikler -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Mevcut Abonelikler"
                               Style="{StaticResource TitleStyle}"
                               FontSize="15" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" x:Name="SubscriptionsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionChanged="SubscriptionsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Uye"
                                               Binding="{Binding Member.FullName}" Width="130"/>
                            <DataGridTextColumn Header="Paket"
                                               Binding="{Binding MembershipPackage.Name}" Width="120"/>
                            <DataGridTextColumn Header="Baslangic"
                                               Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}"
                                               Width="90"/>
                            <DataGridTextColumn Header="Bitis"
                                               Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}"
                                               Width="90"/>
                            <DataGridTemplateColumn Header="Durum" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,3"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="Active">
                                                            <Setter Property="Background" Value="#C6F6D5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="Expired">
                                                            <Setter Property="Background" Value="#FED7D7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="Cancelled">
                                                            <Setter Property="Background" Value="#E2E8F0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="Active">
                                                                <Setter Property="Text" Value="✅ Aktif"/>
                                                                <Setter Property="Foreground" Value="#276749"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="Expired">
                                                                <Setter Property="Text" Value="❌ Suresi Doldu"/>
                                                                <Setter Property="Foreground" Value="#9B2335"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="Cancelled">
                                                                <Setter Property="Text" Value="🚫 Iptal"/>
                                                                <Setter Property="Foreground" Value="#4A5568"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Yenile/İptal Butonları -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="RenewButton" Content="🔄 Uyeligi Yenile"
                                Width="140" Height="35"
                                Background="{StaticResource SecondaryBrush}"
                                Margin="0,0,8,0"
                                Click="RenewButton_Click"/>
                        <Button x:Name="CancelButton" Content="🚫 Iptal Et"
                                Width="100" Height="35"
                                Background="{StaticResource DangerBrush}"
                                Click="CancelButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sağ: Yeni Abonelik Formu -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Yeni Abonelik Olustur"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="15" Margin="0,0,0,15"/>

                        <!-- Üye Seç -->
                        <TextBlock Text="Uye Sec" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="MemberCombo" Height="36" Margin="0,0,0,5"
                                  DisplayMemberPath="FullName"
                                  SelectionChanged="MemberCombo_SelectionChanged"/>

                        <!-- Üye Rapor Durumu -->
                        <Border x:Name="MemberStatusBorder" CornerRadius="5"
                                Padding="8,5" Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <TextBlock x:Name="MemberStatusText" FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <!-- Paket Seç -->
                        <TextBlock Text="Aktif Paketler" Style="{StaticResource LabelStyle}"/>
                        <ListBox x:Name="PackagesListBox" Height="200"
                                 Margin="0,0,0,10"
                                 SelectionChanged="PackagesListBox_SelectionChanged"
                                 BorderBrush="#CBD5E0" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="Ucret: " FontSize="11"
                                                       Foreground="#718096"/>
                                            <TextBlock Text="{Binding Price, StringFormat={}{0} TL}"
                                                       FontSize="11" Foreground="#2D3748"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text=" | " FontSize="11" Foreground="#CBD5E0"/>
                                            <TextBlock Text="Sure: " FontSize="11"
                                                       Foreground="#718096"/>
                                            <TextBlock Text="{Binding DurationMonths, StringFormat={}{0} Ay}"
                                                       FontSize="11" Foreground="#2D3748"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TimeRange}"
                                                   FontSize="11" Foreground="#718096"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Ödeme Yöntemi -->
                        <TextBlock Text="Odeme Yontemi" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="PaymentMethodCombo" Height="36" Margin="0,0,0,15">
                            <ComboBoxItem Content="💵 Nakit" IsSelected="True"/>
                            <ComboBoxItem Content="💳 Kredi Karti"/>
                        </ComboBox>

                        <!-- Özet -->
                        <Border x:Name="SummaryBorder" Background="#EBF4FF"
                                CornerRadius="8" Padding="12" Margin="0,0,0,15"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Abonelik Ozeti" FontWeight="Bold"
                                           FontSize="12" Margin="0,0,0,8"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock x:Name="SummaryMember" FontSize="12"
                                           Foreground="#2D3748"/>
                                <TextBlock x:Name="SummaryPackage" FontSize="12"
                                           Foreground="#2D3748"/>
                                <TextBlock x:Name="SummaryPrice" FontSize="12"
                                           Foreground="#2D3748" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SummaryDates" FontSize="12"
                                           Foreground="#2D3748"/>
                            </StackPanel>
                        </Border>

                        <Button Content="🎫 Aboneligi Olustur" Height="42"
                                Background="{StaticResource PrimaryBrush}"
                                Click="CreateButton_Click"/>

                        <Border x:Name="MessageBorder" CornerRadius="5"
                                Padding="10,8" Margin="0,10,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="MessageText" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>