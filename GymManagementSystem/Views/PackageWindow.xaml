<Window x:Class="GymManagementSystem.Views.PackageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paket Yonetimi" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F0F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <TextBlock Text="📦  Paket Yonetimi" FontSize="18" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center" Margin="25,0"/>
        </Border>

        <!-- İçerik -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: Liste -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Paket Listesi"
                               Style="{StaticResource TitleStyle}"
                               FontSize="15" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" x:Name="PackagesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionChanged="PackagesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Paket Adi"
                                               Binding="{Binding Name}" Width="140"/>
                            <DataGridTemplateColumn Header="Tur" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Padding="5,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PackageType}"
                                                                     Value="TwoDaysPerWeek">
                                                            <Setter Property="Text" Value="📅 Haftada 2 Gun"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PackageType}"
                                                                     Value="ThreeDaysPerWeek">
                                                            <Setter Property="Text" Value="📅 Haftada 3 Gun"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PackageType}"
                                                                     Value="EveryDay">
                                                            <Setter Property="Text" Value="📅 Her Gun"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ucret (TL)"
                                               Binding="{Binding Price}" Width="90"/>
                            <DataGridTextColumn Header="Sure (Ay)"
                                               Binding="{Binding DurationMonths}" Width="80"/>
                            <DataGridTemplateColumn Header="Durum" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,3"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}"
                                                                     Value="True">
                                                            <Setter Property="Background" Value="#C6F6D5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}"
                                                                     Value="False">
                                                            <Setter Property="Background" Value="#FED7D7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}"
                                                                         Value="True">
                                                                <Setter Property="Text" Value="✅ Aktif"/>
                                                                <Setter Property="Foreground" Value="#276749"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}"
                                                                         Value="False">
                                                                <Setter Property="Text" Value="❌ Pasif"/>
                                                                <Setter Property="Foreground" Value="#9B2335"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <Button Content="🔄 Yenile" Width="90" Height="35"
                                Background="#718096" Margin="0,0,8,0"
                                Click="RefreshButton_Click"/>
                        <Button Content="🗑️ Sil" Width="90" Height="35"
                                Background="{StaticResource DangerBrush}"
                                Click="DeleteButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sağ: Form -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Paket Ekle / Duzenle"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="15" Margin="0,0,0,15"/>

                        <TextBlock Text="Paket Adi" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="NameBox" Height="36" Margin="0,0,0,10"/>

                        <TextBlock Text="Paket Turu" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="PackageTypeCombo" Height="36" Margin="0,0,0,10">
                            <ComboBoxItem Content="📅 Haftada 2 Gun" Tag="0"/>
                            <ComboBoxItem Content="📅 Haftada 3 Gun" Tag="1"/>
                            <ComboBoxItem Content="📅 Her Gun" Tag="2"/>
                        </ComboBox>

                        <TextBlock Text="Baslangic Saati (HH:mm)"
                                   Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="StartTimeBox" Height="36" Margin="0,0,0,10"
                                 Text="08:00"/>

                        <TextBlock Text="Bitis Saati (HH:mm)"
                                   Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="EndTimeBox" Height="36" Margin="0,0,0,10"
                                 Text="22:00"/>

                        <TextBlock Text="Sure (Ay)" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="DurationBox" Height="36" Margin="0,0,0,10"
                                 Text="1"/>

                        <TextBlock Text="Ucret (TL)" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="PriceBox" Height="36" Margin="0,0,0,10"/>

                        <CheckBox x:Name="IsActiveCheck" Content="Aktif"
                                  Margin="0,0,0,15" IsChecked="True"
                                  FontSize="13"/>

                        <Button Content="💾 Kaydet" Height="42"
                                Background="{StaticResource SuccessBrush}"
                                Click="SaveButton_Click"/>

                        <Border x:Name="MessageBorder" CornerRadius="5"
                                Padding="10,8" Margin="0,10,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="MessageText" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>