<Window x:Class="GymManagementSystem.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Odeme Islemleri" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F0F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <TextBlock Text="💳  Odeme Islemleri" FontSize="18" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center" Margin="25,0"/>
        </Border>

        <!-- İçerik -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: Liste -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Odeme Gecmisi"
                               Style="{StaticResource TitleStyle}"
                               FontSize="15" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" x:Name="PaymentsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Uye ID"
                                               Binding="{Binding MemberId}" Width="70"/>
                            <DataGridTextColumn Header="Tutar (TL)"
                                               Binding="{Binding Amount}" Width="90"/>
                            <DataGridTemplateColumn Header="Yontem" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Padding="5,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PaymentMethod}"
                                                                     Value="Cash">
                                                            <Setter Property="Text" Value="💵 Nakit"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaymentMethod}"
                                                                     Value="CreditCard">
                                                            <Setter Property="Text" Value="💳 Kredi Karti"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tarih"
                                               Binding="{Binding PaymentDate, StringFormat=dd/MM/yyyy}"
                                               Width="100"/>
                            <DataGridTemplateColumn Header="Durum" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,3"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="Completed">
                                                            <Setter Property="Background" Value="#C6F6D5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="Pending">
                                                            <Setter Property="Background" Value="#E9D8FD"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="Partial">
                                                            <Setter Property="Background" Value="#FEFCBF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="Failed">
                                                            <Setter Property="Background" Value="#FED7D7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="Cancelled">
                                                            <Setter Property="Background" Value="#E2E8F0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="Completed">
                                                                <Setter Property="Text" Value="✅ Tamamlandi"/>
                                                                <Setter Property="Foreground" Value="#276749"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="Pending">
                                                                <Setter Property="Text" Value="⏳ Beklemede"/>
                                                                <Setter Property="Foreground" Value="#553C9A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="Partial">
                                                                <Setter Property="Text" Value="⚠️ Kismi"/>
                                                                <Setter Property="Foreground" Value="#744210"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="Failed">
                                                                <Setter Property="Text" Value="❌ Basarisiz"/>
                                                                <Setter Property="Foreground" Value="#9B2335"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="Cancelled">
                                                                <Setter Property="Text" Value="🚫 Iptal"/>
                                                                <Setter Property="Foreground" Value="#4A5568"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2" Content="🔄 Yenile" Width="90" Height="35"
                            Background="#718096" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="RefreshButton_Click"/>
                </Grid>
            </Border>

            <!-- Sağ: Form -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Yeni Odeme" Style="{StaticResource TitleStyle}"
                                   FontSize="15" Margin="0,0,0,15"/>

                        <TextBlock Text="Uye Sec" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="MemberCombo" Height="36" Margin="0,0,0,5"
                                  DisplayMemberPath="FullName"
                                  SelectionChanged="MemberCombo_SelectionChanged"/>

                        <!-- Abonelik Durum Bilgisi -->
                        <Border x:Name="SubscriptionStatusBorder" CornerRadius="5"
                                Padding="8,5" Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <TextBlock x:Name="SubscriptionStatusText"
                                       FontSize="11" FontWeight="SemiBold"/>
                        </Border>

                        <TextBlock Text="Tutar (TL)" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="AmountBox" Height="36" Margin="0,0,0,10"/>

                        <TextBlock Text="Odeme Yontemi" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="PaymentMethodCombo" Height="36" Margin="0,0,0,10">
                            <ComboBoxItem Content="💵 Nakit" Tag="0"/>
                            <ComboBoxItem Content="💳 Kredi Karti" Tag="1"/>
                        </ComboBox>

                        <TextBlock Text="Odeme Durumu" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="PaymentStatusCombo" Height="36" Margin="0,0,0,20">
                            <ComboBoxItem Content="✅ Tamamlandi" Tag="0"/>
                            <ComboBoxItem Content="⏳ Beklemede" Tag="1"/>
                            <ComboBoxItem Content="⚠️ Kismi Odeme" Tag="2"/>
                            <ComboBoxItem Content="❌ Basarisiz" Tag="3"/>
                            <ComboBoxItem Content="🚫 Iptal" Tag="4"/>
                        </ComboBox>

                        <Button Content="💾 Odeme Kaydet" Height="42"
                                Background="#8E44AD"
                                Click="SaveButton_Click"/>

                        <Border x:Name="MessageBorder" CornerRadius="5"
                                Padding="10,8" Margin="0,10,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="MessageText" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>