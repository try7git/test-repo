<Window x:Class="GymManagementSystem.Views.DeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cihaz ve Bakim Yonetimi" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F0F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <TextBlock Text="🔧  Cihaz ve Bakim Yonetimi" FontSize="18" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center" Margin="25,0"/>
        </Border>

        <!-- İçerik -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: Listeler -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cihaz Listesi -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Cihaz Listesi"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="15" Margin="0,0,0,10"/>

                        <DataGrid Grid.Row="1" x:Name="DevicesGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionChanged="DevicesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cihaz Adi"
                                                   Binding="{Binding Name}" Width="130"/>
                                <DataGridTextColumn Header="Marka"
                                                   Binding="{Binding Brand}" Width="100"/>
                                <DataGridTextColumn Header="Model"
                                                   Binding="{Binding Model}" Width="100"/>
                                <DataGridTemplateColumn Header="Durum" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,3"
                                                    HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Background" Value="#C6F6D5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="UnderMaintenance">
                                                                <Setter Property="Background" Value="#BEE3F8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="UnderRepair">
                                                                <Setter Property="Background" Value="#FEFCBF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Passive">
                                                                <Setter Property="Background" Value="#FED7D7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                    <Setter Property="Text" Value="✅ Aktif"/>
                                                                    <Setter Property="Foreground" Value="#276749"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="UnderMaintenance">
                                                                    <Setter Property="Text" Value="🔵 Bakimda"/>
                                                                    <Setter Property="Foreground" Value="#2B6CB0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="UnderRepair">
                                                                    <Setter Property="Text" Value="🔧 Tamirde"/>
                                                                    <Setter Property="Foreground" Value="#744210"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Passive">
                                                                    <Setter Property="Text" Value="❌ Pasif"/>
                                                                    <Setter Property="Foreground" Value="#9B2335"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Bakım/Tamir Listesi -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Bakim / Tamir Kayitlari"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="15" Margin="0,0,0,10"/>

                        <DataGrid Grid.Row="1" x:Name="MaintenanceGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tur" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,3"
                                                    HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}"
                                                                         Value="Bakim">
                                                                <Setter Property="Background" Value="#BEE3F8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}"
                                                                         Value="Tamir">
                                                                <Setter Property="Background" Value="#FEFCBF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}"
                                                                             Value="Bakim">
                                                                    <Setter Property="Text" Value="🔵 Bakim"/>
                                                                    <Setter Property="Foreground" Value="#2B6CB0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}"
                                                                             Value="Tamir">
                                                                    <Setter Property="Text" Value="🟡 Tamir"/>
                                                                    <Setter Property="Foreground" Value="#744210"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tarih"
                                                   Binding="{Binding Date, StringFormat=dd/MM/yyyy}"
                                                   Width="90"/>
                                <DataGridTextColumn Header="Aciklama"
                                                   Binding="{Binding Description}" Width="150"/>
                                <DataGridTextColumn Header="Maliyet (TL)"
                                                   Binding="{Binding Cost}" Width="90"/>
                                <DataGridTextColumn Header="Yer"
                                                   Binding="{Binding Location}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sağ: Form -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Islem Ekle" Style="{StaticResource TitleStyle}"
                                   FontSize="15" Margin="0,0,0,15"/>

                        <TextBlock Text="Cihaz Sec" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="DeviceCombo" Height="36" Margin="0,0,0,10"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="DeviceCombo_SelectionChanged"/>

                        <TextBlock Text="Islem Turu" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="RecordTypeCombo" Height="36" Margin="0,0,0,10"
                                  SelectionChanged="RecordTypeCombo_SelectionChanged">
                            <ComboBoxItem Content="🔵 Bakim" IsSelected="True"/>
                            <ComboBoxItem Content="🟡 Tamir"/>
                        </ComboBox>

                        <TextBlock Text="Tarih" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="RecordDatePicker" Height="36" Margin="0,0,0,10"/>

                        <TextBlock Text="Aciklama" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="DescriptionBox" Height="36" Margin="0,0,0,10"/>

                        <TextBlock x:Name="StaffLabel" Text="Gorevli"
                                   Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="StaffBox" Height="36" Margin="0,0,0,10"/>

                        <TextBlock Text="Maliyet (TL)" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="CostBox" Height="36" Margin="0,0,0,20"/>

                        <Button Content="💾 Kaydet" Height="42"
                                Background="{StaticResource SuccessBrush}"
                                Click="SaveButton_Click"/>

                        <Border x:Name="MessageBorder" CornerRadius="5"
                                Padding="10,8" Margin="0,10,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="MessageText" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>